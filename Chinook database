--Query that includes the purchased track name with each invoice line ID.
SELECT t.name, i.InvoiceLineId
FROM invoice_items as i
INNER JOIN tracks as t
ON i.TrackId = t.TrackId;

-- Track name AND artist name with each invoice line ID.
SELECT t.name as track_name, art.name as artist_name, item.invoiceLineId as invoice
FROM invoice_items as item 
LEFT JOIN tracks as t 
ON item.trackId = t.trackId
INNER JOIN albums as a 
ON t.AlbumId = a.albumId
LEFT JOIN artists as art
ON a.artistId = art.artistId;

-- Tracks Album name, Media type, and Genre.
SELECT t.name as track_name, 
a.title as album_name, 
media.name as media_type, 
g.name as genre_name
FROM albums as a
LEFT JOIN tracks as t 
ON a.albumId = t.albumId
LEFT JOIN media_types as media
ON t.MediaTypeId = media.MediaTypeId
LEFT JOIN genres as g 
ON t.GenreId = g.GenreId;

-- Total sales made by each sales agent.
SELECT DISTINCT SUM(i.Total) OVER (PARTITION BY SupportRepId) as total_sales,
e.FirstName || ' ' || e.LastName as FullName
FROM employees as e
INNER JOIN customers as c
ON e.employeeId = c.SupportRepId
LEFT JOIN invoices as i
ON c.CustomerID=i.CustomerId;

-- Total sales made by each sales agent
-- DISTINCT is required here because the join to invoices creates one row per invoice line, and the window function repeats the same total on
-- every row for that agent — DISTINCT collapses it back to one row per agent.
SELECT DISTINCT SUM(i.Total) OVER (PARTITION BY e.SupportRepId) AS total_sales,
       e.FirstName || ' ' || e.LastName AS full_name
FROM employees AS e
INNER JOIN customers AS c ON e.employeeId = c.SupportRepId
LEFT JOIN invoices AS i ON c.CustomerID = i.CustomerId;
 
-- Which sales agent made the most dollars in sales in 2009?
SELECT DISTINCT e.LastName, e.FirstName, SUM(i.Total) AS total_sales
FROM employees AS e
INNER JOIN customers AS c ON e.EmployeeId = c.SupportRepId
INNER JOIN invoices AS i ON c.CustomerId = i.CustomerId
WHERE i.InvoiceDate LIKE '%2009%'
GROUP BY e.LastName, e.FirstName
ORDER BY total_sales DESC;
 
-- Rank each sales agent's yearly performance using a CTE.
-- Shows total sales per agent per year, ranked from highest to lowest each year.
WITH agent_yearly_sales AS (
    SELECT e.EmployeeId,
           e.FirstName || ' ' || e.LastName AS agent_name,
           STRFTIME('%Y', i.InvoiceDate) AS sales_year,
           SUM(i.Total) AS total_sales
    FROM employees AS e
    INNER JOIN customers AS c ON e.EmployeeId = c.SupportRepId
    INNER JOIN invoices AS i ON c.CustomerId = i.CustomerId
    GROUP BY e.EmployeeId, agent_name, sales_year
)
SELECT agent_name, sales_year, total_sales,
       RANK() OVER (PARTITION BY sales_year ORDER BY total_sales DESC) AS year_rank
FROM agent_yearly_sales
ORDER BY sales_year, year_rank;
 

